#!/bin/sh
# Run as the console user; an existing preference belongs to that user.
set -eu
[ "$(/usr/bin/id -u)" -ne 0 ] || { echo 'Initial preferences require the profile owner' >&2; exit 1; }
umask 077
if [ -n "${FIELDCRAFT_RECOVERY_DIR:-}" ]; then
    folder=$(/usr/bin/dirname -- "$FIELDCRAFT_RECOVERY_DIR")
elif [ -n "${CI:-}" ] || [ -n "${FIELDCRAFT_CONTROL_PORT:-}" ]; then
    folder=${TMPDIR:-/tmp}/fieldcraft-automation
else
    folder=$HOME/Library/Application\ Support/FieldCraft
fi
prefs=$folder/prefs.json
[ ! -e "$prefs" ] && [ ! -L "$prefs" ] || exit 0
/bin/mkdir -p -- "$folder"
initial=$(/usr/bin/mktemp "$folder/.initial-prefs.XXXXXXXX")
trap '/bin/rm -f -- "$initial"' EXIT
printf '%s\n' '{"show_donate_button":false,"update_check":false}' > "$initial"
/bin/link "$initial" "$prefs" 2>/dev/null || [ -e "$prefs" ] || [ -L "$prefs" ]
