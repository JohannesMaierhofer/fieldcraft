#!/bin/bash
# Apple Installer supplies the target volume as its third argument.
set -euo pipefail
umask 022
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
here=$(cd "$(dirname "$0")" && pwd)
volume=${3:?expected Installer target volume}
root="${volume%/}/Library/Application Support/FieldCraft/NGSolve"
lock="$here/runtime.lock"
read -r target < "$here/arch"
if [[ $(/usr/bin/uname -m) != "$target" ]]; then
    echo "This installer requires native $target execution." >&2
    exit 1
fi
lock_sha=$(/usr/bin/shasum -a 256 "$lock" | /usr/bin/awk '{print $1}')
version="cpython313-ngsolve2608-$target-${lock_sha:0:16}"
mkdir -p "$root/runtimes"
for link in current python bridge; do
    if [[ -e "$root/$link" && ! -L "$root/$link" ]]; then
        echo "Unmanaged installation path: $root/$link" >&2
        exit 1
    fi
done
stage=$(/usr/bin/mktemp -d "$root/.install-XXXXXXXX")
cleanup() { /bin/rm -rf "$stage"; }
trap cleanup EXIT
package_dir="$root/runtimes/$version"
smoke() {
    # -I ignores PYTHON* variables and user packages. A tiny real FE integral
    # exercises the native modules and their shared libraries after relocation.
    "$1" -I -B - <<'PYTHON_SMOKE'
import importlib.metadata as metadata
from pathlib import Path
import sys

import netgen
import ngsolve as ng
import numpy
import studypype
import yaml
from netgen.geom2d import unit_square

prefix = Path(sys.prefix).resolve()
assert all(Path(module.__file__).resolve().is_relative_to(prefix) for module in (ng, numpy, netgen, studypype, yaml))
versions = {'ngsolve': '6.2.2608', 'netgen-mesher': '6.2.2608', 'netgen-occt': '7.8.1',
            'numpy': '2.3.5', 'studypype': '3.0.0', 'PyYAML': '6.0.3', 'uv': '0.11.26'}
assert all(metadata.version(name) == version for name, version in versions.items())
mesh = ng.Mesh(unit_square.GenerateMesh(maxh=.5))
assert abs(ng.Integrate(1.0, mesh) - 1.0) < 1e-12
print(sys.version, ng.__version__, mesh.ne)
PYTHON_SMOKE
    "$1" -I -B -m uv --version
}
if [[ ! -e "$package_dir" ]]; then
    mkdir "$stage/downloads" "$stage/payload"
    wheels=()
    runtime=''; bridge=''
    while read -r digest url; do
        [[ "$digest" =~ ^[0-9a-f]{64}$ ]]
        case "$url" in
            https://github.com/astral-sh/python-build-standalone/releases/download/*|https://files.pythonhosted.org/packages/*|https://codeload.github.com/JohannesMaierhofer/fieldcraft-ngsolve/zip/*) ;;
            *) echo "Unexpected runtime download host." >&2; exit 1 ;;
        esac
        name=${url##*/}; name=${name//%2B/+}
        if [[ "$url" == https://codeload.github.com/* ]]; then name="bridge-$name.zip"; fi
        if [[ -d "$here/offline" ]]; then
            input="$here/offline/$name"
        else
            input="$stage/downloads/$name"
            /usr/bin/curl --disable --proto '=https' --proto-redir '=https' --fail --silent --show-error --location --retry 2 --connect-timeout 20 --max-time 600 --output "$input" "$url"
        fi
        actual=$(/usr/bin/shasum -a 256 "$input" | /usr/bin/awk '{print $1}')
        if [[ "$actual" != "$digest" ]]; then
            echo "Checksum failed: $name" >&2
            exit 1
        fi
        case "$name" in
            *.tar.gz) runtime="$input" ;;
            *.whl) wheels+=("$input") ;;
            bridge-*.zip) bridge="$input" ;;
            *) exit 1 ;;
        esac
    done < "$lock"
    [[ -n "$runtime" && -n "$bridge" && ${#wheels[@]} -gt 0 ]]
    tar -xzf "$runtime" -C "$stage/payload"
    python="$stage/payload/python/bin/python3"
    PIP_CONFIG_FILE=/dev/null "$python" -I -B -m pip --isolated --no-cache-dir --disable-pip-version-check install \
        --no-index --no-deps --no-compile --no-warn-script-location "${wheels[@]}"
    "$python" -I -B -m pip --isolated --no-cache-dir --disable-pip-version-check check
    /usr/bin/unzip -q "$bridge" -d "$stage/bridge-source"
    directories=("$stage"/bridge-source/fieldcraft-ngsolve-*)
    [[ ${#directories[@]} == 1 && -f "${directories[0]}/workflow.py" && -f "${directories[0]}/show_run.py" ]]
    mv "${directories[0]}" "$stage/payload/bridge"
    cp "$lock" "$stage/payload/runtime.lock"
    smoke "$python"
    # Rename atomically. If an identical installer wins the race, retain the
    # winning complete directory and verify its lock and runtime below.
    "$python" -I -B - "$stage/payload" "$package_dir" <<'RENAME'
import errno
import os
import sys

source, destination = sys.argv[1:]
try:
    os.rename(source, destination)
except OSError as error:
    if error.errno not in (errno.EEXIST, errno.ENOTEMPTY) or not os.path.isdir(destination):
        raise
RENAME
fi
cmp -s "$package_dir/runtime.lock" "$lock"
smoke "$package_dir/python/bin/python3"
# Notices can change while the binary lock remains the same. Publish them atomically.
cp "$here/NOTICE.txt" "$stage/NOTICE.txt"
/bin/mv -fh "$stage/NOTICE.txt" "$package_dir/NOTICE.txt"
ln -s "runtimes/$version" "$stage/current"
/bin/mv -fh "$stage/current" "$root/current"
for link in python bridge; do
    ln -s "current/$link" "$stage/$link"
    /bin/mv -fh "$stage/$link" "$root/$link"
done
# Update the installed command on every installer run, including runtime reuse.
cp "$here/fieldcraft-ngsolve" "$stage/fieldcraft-ngsolve"
chmod 755 "$stage/fieldcraft-ngsolve"
/bin/mv -fh "$stage/fieldcraft-ngsolve" "$root/fieldcraft-ngsolve"
