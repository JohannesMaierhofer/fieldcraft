#!/bin/bash
# Run a native FieldCraft analysis with the installed private Python.
set -eu
root=$(cd "$(dirname "$0")" && pwd)
volume=$(cd "$root/../../../.." && pwd)
cli="${FIELDCRAFT_CLI:-${volume%/}/Applications/FieldCraft.app/Contents/MacOS/fieldcraft-cli}"
exec "$cli" ngsolve "$@" --python "$root/python/bin/python3"
